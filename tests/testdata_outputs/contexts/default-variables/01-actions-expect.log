##[group]Run checked=0
checked=0
failed=0
trim() { printf '%s' "$1" | sed 's/^[[:space:]]*//; s/[[:space:]]*$//'; }
while IFS= read -r line; do
  label=""
  case "$line" in
    *" # "*)
      label="$(trim "${line#* # }")"
      line="${line%% # *}"
      ;;
  esac
  line="$(trim "$line")"
  [ -z "$line" ] && continue
  checked=$((checked + 1))
  # Padded, so a side that is empty still has the space the operator sits between.
  padded=" $line "
  case "$padded" in
    *" != "*) operator="!="; actual="${padded%% != *}"; expected="${padded#* != }" ;;
    *" == "*) operator="=="; actual="${padded%% == *}"; expected="${padded#* == }" ;;
    *)
      echo "FAIL  ${label:-check $checked}: not a check: $line"
      failed=$((failed + 1))
      continue
      ;;
  esac
  actual="$(trim "$actual")"
  expected="$(trim "$expected")"
  actual="$(eval "printf '%s' \"$actual\"" 2>/dev/null)"
  held=0
  if [ "$operator" = "==" ]; then
    [ "$actual" = "$expected" ] && held=1
  else
    [ "$actual" != "$expected" ] && held=1
  fi
  if [ "$held" = "1" ]; then
    echo "ok    ${label:-check $checked}"
  else
    echo "FAIL  ${label:-check $checked}: expected $operator \"$expected\", got \"$actual\""
    failed=$((failed + 1))
  fi
done <<'CANOPY_CHECKS'
$CI == true
$GITHUB_ACTIONS == true
$GITHUB_EVENT_NAME == push
$GITHUB_JOB == variables                            # the id, not the display name
$GITHUB_WORKFLOW == Default variables
$GITHUB_REF_TYPE == branch
$GITHUB_RUN_ATTEMPT != ''
$GITHUB_RUN_ID != ''
$GITHUB_RUN_NUMBER != ''
$GITHUB_SERVER_URL == https://github.com
$GITHUB_API_URL == https://api.github.com
$GITHUB_GRAPHQL_URL == https://api.github.com/graphql
$GITHUB_REPOSITORY != ''
$GITHUB_REPOSITORY_OWNER != ''
$GITHUB_REF != ''
$GITHUB_REF_NAME != ''
$GITHUB_SHA != ''
$GITHUB_ACTOR != ''
$RUNNER_OS == Linux
$RUNNER_ARCH != ''
$RUNNER_NAME != ''
$RUNNER_ENVIRONMENT != ''
$(test -d "$GITHUB_WORKSPACE" && echo yes) == yes    # the workspace is a directory
$(test -d "$RUNNER_TEMP" && echo yes) == yes         # and so is the temp
$(test -f "$GITHUB_EVENT_PATH" && echo yes) == yes   # the payload is on disk
$(test -f "$GITHUB_ENV" && echo yes) == yes          # with the state files beside it
$(test -f "$GITHUB_OUTPUT" && echo yes) == yes
$(test -f "$GITHUB_PATH" && echo yes) == yes
$(test -f "$GITHUB_STEP_SUMMARY" && echo yes) == yes
push == push                     # what the variables come from
Default variables == Default variables
variables == variables
Linux == Linux
ferranbt/canopy != ''
branch == branch
 ==                                     # but the `env` context holds
 ==                         # only what a workflow set
CANOPY_CHECKS
if [ "$checked" = "0" ]; then
  echo "no checks were given"
  exit 1
fi
echo "$checked check(s), $failed failed"
[ "$failed" = "0" ]
shell: /usr/bin/bash --noprofile --norc -e -o pipefail {0}
