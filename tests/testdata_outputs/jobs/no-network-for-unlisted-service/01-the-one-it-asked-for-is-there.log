##[group]Run for attempt in $(seq 30); do
for attempt in $(seq 30); do
  (exec 3<>/dev/tcp/cache/6379) 2>/dev/null && break
  sleep 1
done
exec 3<>/dev/tcp/cache/6379
printf 'PING\r\n' >&3
head -c 7 <&3 | grep -q PONG
echo "cache answered"
shell: bash --noprofile --norc -e -o pipefail {0}
