##[group]Run echo "## What happened" >> "$GITHUB_STEP_SUMMARY"
echo "## What happened" >> "$GITHUB_STEP_SUMMARY"
echo "a line about it" >> "$GITHUB_STEP_SUMMARY"
# Each step gets its own, so a step can read back what it wrote.
grep -q "What happened" "$GITHUB_STEP_SUMMARY"
echo "wrote a summary"
