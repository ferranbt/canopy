##[group]Run actions/expect
with:
  checks: a-b == a-b
xx == xx                       # an argument used twice
true == true                       # and any type is spelled out
1.5 == 1.5
a+b+c == a+b+c
a,b == a,b                # a comma when none is given
lonely == lonely                     # a single value joins to itself
true == true
true == true                # strings are matched case-insensitively
true == true
true == true
false == false
true == true
true == true
false == false
text == text                        # a scalar comes back as itself
3 == 3
1.5 == 1.5                           # written the way a number is
true == true
deep == deep        # reaching into an object
20 == 20                       # and into an array
1 == 1                      # either way of reaching in
 ==                           # a key that is not there
